# Sanitized Production Environment Template for OVIC EON ERS
# Never commit real private signing keys, TLS keys, or API secrets to Git.

EON_ERS_API_AUTH=true
EON_ERS_SIGNING_KEY_ID=ovic-ers-signing-prod-01
# Provide private Ed25519 key via secret mount or CI secret manager:
EON_ERS_SIGNING_PRIVATE_KEY_PATH=/run/secrets/ers_ed25519_private.pem
OMP_NUM_THREADS=4
